{
  "description": "Feed Codex lifecycle state to the local Signal Monitor app.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 1}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "SIGNAL_MONITOR_INTEGRATION=1 SIGNAL_MONITOR_DATA_DIR=\"${HOME}/Library/Application Support/Signal Monitor\" /usr/bin/python3 \"${HOME}/Library/Application Support/Signal Monitor/signal_monitor_hook.py\"", "timeout": 3}]}]
  }
}
